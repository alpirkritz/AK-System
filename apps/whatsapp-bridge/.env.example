# WhatsApp Bridge — copy to .env (git-ignored)

PORT=3001
AUTH_STATE_PATH=./data/auth
BRIDGE_SECRET=change-me-to-a-long-random-string

# OFF by default — only set REPLY_ENABLED=1 when Gemini works and you want self-chat AI
REPLY_ENABLED=0

# Phase 2: AK System webhook (Gemini replies) — required when REPLY_ENABLED=1
# AK_WEBHOOK_URL=https://your-app.up.railway.app/api/whatsapp/webhook
# AK_GROUP_SUMMARY_URL=https://your-app.up.railway.app/api/whatsapp/group-summary

# Optional: override auto-detected self JID after first connect
# SELF_JID=972501234567@s.whatsapp.net

# Optional: Message Yourself @lid JID (newer WhatsApp)
# SELF_LID=226855995088946@lid

# Phase 3: comma-separated group JIDs to watch
# WATCH_GROUP_JIDS=120363012345678901@g.us

# Name shown in WhatsApp → Linked Devices
DEVICE_NAME=AK System
