# Copy this file to apps/web/.env.local and fill in the values.
# See root .env.example for documentation on each variable.

DATABASE_PATH=./data/ak_system.sqlite

NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# NextAuth (Google sign-in) – same Google OAuth client as below
# Add redirect URI in Google Cloud Console: https://your-domain.com/api/auth/callback/google
NEXTAUTH_SECRET=
NEXTAUTH_URL=
# Comma-separated Google emails allowed to sign in (set to your email when public).
ALLOWED_EMAILS=alpirkritz@gmail.com,alpir@daz.guru

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Android OAuth for Helm app (com.alpir.helm) — required for native mobile sign-in
GOOGLE_ANDROID_CLIENT_ID=

GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=

TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=

# ── Notion ────────────────────────────────────────────────────────────────────
# Single-account (legacy): one integration token; the historical task DBs +
# Assistant Inbox DB are used automatically.
NOTION_API_KEY=
# Assignee name filter for the task scan.
NOTION_USER_NAME=Alpir Kritzler
# Multi-account (preferred): JSON array of accounts. Each database is typed
# 'tasks' | 'meetings' | 'assistant' | 'people' | 'projects' | 'companies' | 'meeting_notes'.
# The people/projects/companies/meeting_notes types power the Meeting Prep Herald (04) —
# add those DB IDs so it can enrich meetings with participants, entities and past notes.
# Share each DB with its integration in Notion (⋯ → Connections). Overrides NOTION_API_KEY.
# NOTION_ACCOUNTS=[{"label":"Personal","token":"ntn_xxx","databases":[{"id":"181e7d50-...","name":"Personal To-do","type":"tasks"},{"id":"aaaa...","name":"Meetings","type":"meetings"},{"id":"325e7d50-...","name":"Assistant Inbox","type":"assistant"},{"id":"pppp...","name":"People","type":"people"},{"id":"rrrr...","name":"Projects","type":"projects"},{"id":"mmmm...","name":"Companies","type":"companies"},{"id":"nnnn...","name":"AI Meeting Notes","type":"meeting_notes"}]},{"label":"DAZ","token":"ntn_yyy","databases":[{"id":"bbbb...","name":"DT - Action items","type":"tasks"},{"id":"cccc...","name":"DAZ Meetings","type":"meetings"}]}]

# WhatsApp Bridge (run apps/whatsapp-bridge separately with persistent volume)
WHATSAPP_BRIDGE_URL=http://localhost:3001
WHATSAPP_BRIDGE_SECRET=
# WHATSAPP_ALLOWED_JID=

# Optional: set to 1 to send a short feed digest to Telegram after each cron sync
FEED_SEND_TELEGRAM_DIGEST=

# Optional: secret for protecting cron endpoints — set in production (EC2 deploy/production.env)
CRON_SECRET=

# Web Push (PWA notifications). Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:you@example.com

# Direct Firebase Admin for ARO Android push (FCM). Never commit the private key.
# FIREBASE_PROJECT_ID=helm-push-969711
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-…@helm-push-969711.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n…\n-----END PRIVATE KEY-----\n"

# Cloudflare Tunnel (optional named tunnel for stable HTTPS hostname)
# CLOUDFLARE_TUNNEL_NAME=ak-system

GEMINI_API_KEY=

GEMINI_MODEL=gemini-2.5-flash
# Extended thinking: high for Gemini 3.x; -1 = dynamic extended for Gemini 2.5
GEMINI_THINKING_LEVEL=high
GEMINI_THINKING_BUDGET=-1

# Agent engine: gemini (default when GEMINI_API_KEY set) or cursor (requires CURSOR_API_KEY)
AGENT_ENGINE=gemini
# CURSOR_API_KEY=
# CURSOR_AGENT_MODEL=composer-2.5

# Optional: for flight search tool (SerpAPI)
SERPAPI_KEY=
