# Backend URL — use stable Railway/production URL (NOT a random trycloudflare tunnel)
EXPO_PUBLIC_API_URL=https://your-app.up.railway.app

# Google OAuth — same Web client ID as apps/web GOOGLE_CLIENT_ID
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id

# Android OAuth client for com.alpir.helm (recommended for native sign-in)
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id

# Set by `eas init` — optional if projectId is already in app.config.ts
# EAS_PROJECT_ID=
