# Dependencies and build output
node_modules
**/.next
!apps/web/.next
**/dist
**/.pnpm-store

# Env and secrets (use --env-file at run).
# The nested app env files need their own patterns — `.env.*` only matches the root,
# and a stale apps/web/.env.local baked into the image overrides production.env.
.env
.env.*
!.env.example
**/.env
**/.env.local
**/.env.local.bak-*
!**/.env.example
!**/.env.local.example

# Data and local state
**/data/*.sqlite
apps/web/data

# Git and IDE
.git
.gitignore
.cursor
*.md
!DEPLOY.md
!A_Agents/
!A_Agents/**
!S_Skills/
!S_Skills/**
!C_Core/
!C_Core/**
!B_Brain/
!B_Brain/**
!M_Memory/
!M_Memory/**
!O_Output/
!O_Output/**

# Tests and tooling
**/e2e
**/test-results
**/playwright-report
**/*.test.ts
**/*.spec.ts
**/__tests__
**/test-data
scripts/*
!scripts/production-start.sh
!scripts/db-push.sh
capture-screenshots.mjs

# Misc
*.log
.DS_Store
var
