# Production environment — copy to deploy/production.env and fill in.
# Used by docker-compose.production.yml and scripts/install-server-cron.sh.
# Do NOT commit real secrets (deploy/production.env is git-ignored).

# ── App URL (HTTPS, stable) ───────────────────────────────────────────────────
# EC2 + domain (Caddy) or Cloudflare Tunnel hostname.
NEXT_PUBLIC_APP_URL=https://your-domain.com
NEXTAUTH_URL=https://your-domain.com

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=
# Comma-separated Google emails allowed to sign in
ALLOWED_EMAILS=you@example.com

# ── Database (Docker volume mounted at /data) ─────────────────────────────────
DATABASE_PATH=/data/ak_system.sqlite

# ABC workspace root inside Docker (/app = repo root in container)
ABC_ROOT=/app

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Helm Android app (com.alpir.helm) — required for native Google sign-in
GOOGLE_ANDROID_CLIENT_ID=

# Calendar (optional)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=

# ── Cron protection (required in production) ──────────────────────────────────
# Generate: openssl rand -base64 32 ; used by the server crontab.
CRON_SECRET=

# ── Web Push (PWA) ────────────────────────────────────────────────────────────
# Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:you@example.com

# ── Expo Push (Helm mobile app, optional) ─────────────────────────────────────
# EXPO_ACCESS_TOKEN=

# ── AI / integrations (copy from local .env.local as needed) ──────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=
NOTION_API_KEY=
NOTION_USER_NAME=
# Multi-account Notion (preferred, overrides NOTION_API_KEY). JSON array; each DB
# typed 'tasks' | 'meetings' | 'assistant'. Share each DB with its integration.
# NOTION_ACCOUNTS=[{"label":"Personal","token":"ntn_xxx","databases":[{"id":"...","name":"Personal To-do","type":"tasks"},{"id":"...","name":"Meetings","type":"meetings"},{"id":"...","name":"Assistant Inbox","type":"assistant"}]},{"label":"DAZ","token":"ntn_yyy","databases":[{"id":"...","name":"DT - Action items","type":"tasks"},{"id":"...","name":"DAZ Meetings","type":"meetings"}]}]

# ── WhatsApp Bridge (optional, separate service) ──────────────────────────────
# WHATSAPP_BRIDGE_URL=http://whatsapp-bridge:3001
# WHATSAPP_BRIDGE_SECRET=

# ── Timezone for cron logic ───────────────────────────────────────────────────
TIMEZONE=Asia/Jerusalem
