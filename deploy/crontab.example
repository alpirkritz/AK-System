# AK System cron — runs on the EC2 instance (replaces .github/workflows/cron.yml).
# Installed by scripts/install-server-cron.sh, which substitutes __CRON_SECRET__
# and __APP_URL__ from deploy/production.env.
#
# Times are UTC (Ubuntu default). Israel = UTC+2 (winter) / UTC+3 (summer).
# Adjust if your instance timezone differs (timedatectl set-timezone ...).
SHELL=/bin/bash

# Minute offsets: the pure polling jobs (calendar/notion/transcript/commitment
# scans, group summary) are staggered (e.g. 2-59/10) so they don't all hit the
# 1 GB web container on the same minute as the every-15-min jobs. Jobs that
# match a configured HH:MM (scheduled-agents, morning briefing, digests,
# pre-meeting, task reminder) keep their original minutes on purpose.

# Morning briefing — every 15 min; the route sends at the time set in Settings > Notifications (default 07:00 IST)
*/15 * * * * curl -sf -X POST -H "Authorization: Bearer __CRON_SECRET__" __APP_URL__/api/cron/morning-briefing >/dev/null 2>&1

# Calendar → meetings sync — every 15 min
3-59/15 * * * * curl -sf -X POST -H "Authorization: Bearer __CRON_SECRET__" __APP_URL__/api/cron/calendar-sync >/dev/null 2>&1

# Notion → tasks + people sync (also pulls AI meeting-notes bodies + auto-triggers
# conversation analysis/WhatsApp when a transcript shows up) — every 10 min
# (was 30 min; shortened so post-meeting analysis lands closer to real time)
2-59/10 * * * * curl -sf -X POST -H "Authorization: Bearer __CRON_SECRET__" __APP_URL__/api/cron/notion-sync >/dev/null 2>&1

# Notion release notes → WhatsApp "טכני" (every 5 min; draft mode until WhatsApp channel enabled)
*/5 * * * * curl -sf -X POST -H "Authorization: Bearer __CRON_SECRET__" __APP_URL__/api/cron/notion-release-notes >/dev/null 2>&1

# Transcript analysis safety net — catches meetings that ended in the last 30 min
# with a transcript already synced but no analysis yet (belt-and-suspenders for
# the notion-sync auto-trigger above) — every 10 min
6-59/10 * * * * curl -sf -X POST -H "Authorization: Bearer __CRON_SECRET__" __APP_URL__/api/cron/transcript-analysis >/dev/null 2>&1

# Daily meeting summary — every 15 min; the route sends at the time set in Settings > Notifications (default 20:00 IST)
*/15 * * * * curl -sf -X POST -H "Authorization: Bearer __CRON_SECRET__" __APP_URL__/api/cron/daily-meeting-summary >/dev/null 2>&1

# Pre-meeting briefing — every 5 min
*/5 * * * * curl -sf -X POST -H "Authorization: Bearer __CRON_SECRET__" __APP_URL__/api/cron/pre-meeting-briefing >/dev/null 2>&1

# Task reminder — every minute
* * * * * curl -sf -X POST -H "Authorization: Bearer __CRON_SECRET__" __APP_URL__/api/cron/task-reminder >/dev/null 2>&1

# Feed sync — every 6 hours
0 */6 * * * curl -sf -X POST -H "Authorization: Bearer __CRON_SECRET__" __APP_URL__/api/cron/feed-sync >/dev/null 2>&1

# WhatsApp daily digest of every followed group — every 15 min, fires at the configured HH:MM (default 20:30)
*/15 * * * * curl -sf -X POST -H "Authorization: Bearer __CRON_SECRET__" __APP_URL__/api/cron/whatsapp-daily-digest >/dev/null 2>&1

# WhatsApp group summary — every 15 min. Skipped for the rest of the local day after the daily digest sends.
9-59/15 * * * * curl -sf -X POST -H "Authorization: Bearer __CRON_SECRET__" __APP_URL__/api/cron/whatsapp-group-summary >/dev/null 2>&1

# WhatsApp message retention — daily at 04:15; purges group messages older than WHATSAPP_MESSAGE_RETENTION_DAYS (default 30)
15 4 * * * curl -sf -X POST -H "Authorization: Bearer __CRON_SECRET__" __APP_URL__/api/cron/whatsapp-message-retention >/dev/null 2>&1
30 4 * * * curl -sf -X POST -H "Authorization: Bearer __CRON_SECRET__" __APP_URL__/api/cron/people-duplicates >/dev/null 2>&1
# 1:1 WhatsApp commitments — every 10 min. Does not send the nightly summary.
4-59/10 * * * * curl -sf -X POST -H "Authorization: Bearer __CRON_SECRET__" __APP_URL__/api/cron/whatsapp-dm-commitments >/dev/null 2>&1
# Group WhatsApp commitments — every 10 min. Only proposes for a sender resolved to a known person.
7-59/10 * * * * curl -sf -X POST -H "Authorization: Bearer __CRON_SECRET__" __APP_URL__/api/cron/whatsapp-group-commitments >/dev/null 2>&1
# Slack channel commitments — every 10 min. Only enabled channels.
8-59/10 * * * * curl -sf -X POST -H "Authorization: Bearer __CRON_SECRET__" __APP_URL__/api/cron/slack-commitments >/dev/null 2>&1
# 1:1 WhatsApp summaries (19:00 UTC ≈ 21:00/22:00 Israel). Commitments are also proposed here if the 10-min scan missed one.
0 19 * * * curl -sf -X POST -H "Authorization: Bearer __CRON_SECRET__" __APP_URL__/api/cron/whatsapp-dm-summary >/dev/null 2>&1
# Gmail threads with known people (last 30 days) + proposed commitments — hourly
20 * * * * curl -sf -X POST -H "Authorization: Bearer __CRON_SECRET__" __APP_URL__/api/cron/email-sync >/dev/null 2>&1

# Bank & credit card sync — daily at 04:45 IST (01:45 UTC), before morning briefing.
# Runs israeli-bank-scrapers sequentially (one Chromium at a time) — keep daily, do not increase.
45 1 * * * curl -sf -X POST -H "Authorization: Bearer __CRON_SECRET__" __APP_URL__/api/cron/bank-sync >/dev/null 2>&1

# Cash-flow narrative — daily at 05:30 IST (02:30 UTC), after bank sync.
# Skips Gemini when the stored reading still matches today's facts.
30 2 * * * curl -sf -X POST -H "Authorization: Bearer __CRON_SECRET__" __APP_URL__/api/cron/finance-narrative >/dev/null 2>&1

# Cross-domain harness — every 6 hours. Re-indexes the world model and runs the
# reasoner. Only urgent insights are pushed, at most once a day.
10 */6 * * * curl -sf -X POST -H "Authorization: Bearer __CRON_SECRET__" __APP_URL__/api/cron/harness-insights >/dev/null 2>&1

# Scheduled ABC agents — every 15 min. Runs agents whose clock schedule (set in
# /agents/manage ▸ הגדרות והרצה) matches the current HH:MM.
# Replaces /api/cron/agent-triggers, which still forwards here but is deprecated.
*/15 * * * * curl -sf -X POST -H "Authorization: Bearer __CRON_SECRET__" __APP_URL__/api/cron/scheduled-agents >/dev/null 2>&1
