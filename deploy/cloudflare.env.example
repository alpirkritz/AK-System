# Cloudflare Named Tunnel — copy to deploy/cloudflare.env (git-ignored).
# Get token: one.dash.cloudflare.com → Networks → Tunnels → ak-system → Install connector

# Paste the tunnel install token from Cloudflare Zero Trust dashboard
CLOUDFLARE_TUNNEL_TOKEN=

# Your stable public URL (configured as Public Hostname in the tunnel dashboard)
APP_URL=https://ak.yourdomain.com
