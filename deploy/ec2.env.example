# Deploy connection settings for scripts/deploy-ec2.sh.
# Copy to deploy/ec2.env and fill in (git-ignored — no secrets in git).

# Public IP / DNS of the EC2 instance (Elastic IP recommended)
DEPLOY_HOST=1.2.3.4

# SSH user (Ubuntu AMI default is 'ubuntu')
DEPLOY_USER=ubuntu

# App directory on the instance (created by ec2-bootstrap.sh)
DEPLOY_PATH=/opt/ak-system

# Path to the SSH private key for the instance
SSH_KEY=~/.ssh/ak-system.pem

# Public HTTPS URL — used for the post-deploy health check.
# Leave as the localhost fallback to health-check on the box instead.
APP_URL=https://your-domain.com
