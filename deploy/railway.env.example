# Railway production environment — copy values into Railway → Variables.
# Do NOT commit real secrets. See docs/deploy/railway-production.md

# ── App URL (HTTPS, stable) ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://your-app.up.railway.app
NEXTAUTH_URL=https://your-app.up.railway.app

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=
# Comma-separated Google emails allowed to sign in
ALLOWED_EMAILS=you@example.com

# ── Database (Railway volume mounted at /data) ────────────────────────────────
DATABASE_PATH=/data/ak_system.sqlite

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Helm Android app (com.alpir.helm) — required for native Google sign-in
GOOGLE_ANDROID_CLIENT_ID=

# Calendar (optional)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=

# ── Cron protection (required in production) ────────────────────────────────
# Generate: openssl rand -base64 32
CRON_SECRET=

# ── Web Push (PWA) ────────────────────────────────────────────────────────────
# Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:you@example.com

# ── Expo Push (Helm mobile app, optional) ───────────────────────────────────
# EXPO_ACCESS_TOKEN=

# ── AI / integrations (copy from local .env.local as needed) ──────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=
NOTION_API_KEY=
NOTION_USER_NAME=

# ── WhatsApp Bridge (separate service — see deploy/docker-compose.production.yml)
# WHATSAPP_BRIDGE_URL=http://whatsapp-bridge:3001
# WHATSAPP_BRIDGE_SECRET=

# ── Timezone for cron logic ───────────────────────────────────────────────────
TIMEZONE=Asia/Jerusalem
